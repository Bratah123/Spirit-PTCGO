<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SpiritSpeedMod</RootNamespace>
    <AssemblyName>SpiritSpeedMod</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- BepInEx (installed into the game folder) -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\..\PokemonTradingCardGameOnline\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\PokemonTradingCardGameOnline\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies (read-only compile references) -->
  <ItemGroup>
    <Reference Include="pie-src">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\pie-src.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="core">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>..\..\PokemonTradingCardGameOnline\Pokemon Trading Card Game Online_Data\Managed\UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
